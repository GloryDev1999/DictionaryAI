# ============================================================
# Thư ký Kim v6 — Biến môi trường cho DSH profile `kim`
# Sao chép thành .env ở thư mục chạy lệnh. KHÔNG commit file thật.
# ============================================================

# --- DSH Home riêng (cách ly settings.yaml của GUI) ---
DSH_HOME=/home/codespace/.dsh-kim
DSH_CWD=/home/codespace/Thư viện

# --- Agent LLM (persona chat của Kim, độc lập với API Rotator bên trong tools) ---
KIM_LLM_API_KEY=
KIM_LLM_BASE_URL=https://api.xkiro.com/v1
KIM_LLM_MODEL=qwen/qwen3.8-max
KIM_LLM_THINKING=disabled
KIM_LLM_MODELS=[{"id":"qwen/qwen3.8-max","name":"qwen3.8-max","contextWindow":131072}]

# ============================================================
# API ROTATOR — Cấu hình đa provider cho pipeline kim_*
# JSON array: mỗi provider có baseURL + apiKeyEnv + models[].
# Models có roles: "vision" | "orchestrator" | "synthesizer" | "fallback" | "lightweight"
# Tự động xoay vòng khi 429/quota exhausted. Thêm provider mới chỉ cần append vào array.
# ============================================================
KIM_PROVIDERS=[{"name":"xkiro","baseURL":"https://api.xkiro.com/v1","apiKeyEnv":"XKIRO_API_KEY","models":[{"id":"deepseek/deepseek-v4-pro","roles":["orchestrator"]},{"id":"xiaomi/mimo-v2.5-pro","roles":["vision"]},{"id":"mistralai/mistral-medium-3.5","roles":["synthesizer"]},{"id":"deepseek/deepseek-v4-flash","roles":["fallback","lightweight"]},{"id":"mistralai/mistral-large-2512","roles":["fallback"]},{"id":"minimax/minimax-m2.7","roles":["lightweight"]}]}]

# --- API Keys cho các provider (set theo apiKeyEnv ở trên) ---
XKIRO_API_KEY=
# Thêm provider khác:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Supabase (DictionaryAI) ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
KIM_ADMIN_SESSION_TOKEN=

# --- Vector profile (phải khớp DictionaryAI) ---
KIM_VECTOR_MODEL=onnx-community/dinov2-small
KIM_VECTOR_MODEL_VERSION=ef1fb10
KIM_PREPROCESS_VERSION=kim_canon_v2
KIM_EMBEDDING_PROFILE=cls_l2_v1
KIM_VECTOR_DIMENSION=384
KIM_VECTOR_MIN=0.55

# --- Endpoint embedding (DINOv2 server-side) ---
KIM_EMBEDDING_ENDPOINT=
KIM_EMBEDDING_BEARER_TOKEN=

# --- Media base (proxy ảnh DictionaryAI) ---
KIM_MEDIA_BASE_URL=https://<dictionaryai-domain>/api/media