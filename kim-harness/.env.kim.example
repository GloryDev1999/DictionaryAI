# Cấu hình đã xác minh hoạt động cho profile `kim` (DSH_HOME=/home/codespace/.dsh-kim)
# Sao chép thành .env ở thư mục chạy lệnh. KHÔNG commit giá trị thật.

# --- LLM qua xkiro (endpoint tùy biến chuẩn OpenAI/DeepSeek, không khóa cứng) ---
KIM_LLM_API_KEY=
KIM_LLM_BASE_URL=https://api.xkiro.com/v1
KIM_LLM_MODEL=qwen/qwen3.8-max
KIM_LLM_THINKING=disabled
KIM_LLM_MODELS=[{"id":"qwen/qwen3.8-max","name":"qwen3.8-max","contextWindow":131072}]

# --- DSH riêng cho Thư ký Kim (cách ly settings.yaml của GUI) ---
DSH_HOME=/home/codespace/.dsh-kim
DSH_CWD=/home/codespace/Thư viện