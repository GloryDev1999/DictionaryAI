# ============================================================
# Thư ký Kim (DSH profile `kim`) — biến môi trường
# Sao chép thành .env ở thư mục chạy lệnh, hoặc export trực tiếp.
# KHÔNG commit file .env thật vào repo.
# ============================================================

# --- LLM endpoint tùy biến (xkiro / chuẩn DeepSeek-OpenAI) ---
KIM_LLM_API_KEY=sk-...
KIM_LLM_BASE_URL=https://your-xkiro-endpoint/v1
# Bật thinking nếu endpoint hỗ trợ reasoning_effort (mặc định: tắt)
KIM_LLM_THINKING=disabled
KIM_LLM_MODEL=deepseek-chat
# Danh sách model quảng cáo (JSON array), pass-through vẫn hoạt động với id ngoài danh sách
KIM_LLM_MODELS=[{"id":"deepseek-chat","contextWindow":64000}]

# --- Supabase (DictionaryAI) ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Chỉ cần cho tool quản trị vector (search/upsert/lifecycle)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Session token quản trị cho các thao tác cần xác thực app_me
KIM_ADMIN_SESSION_TOKEN=

# --- Vector profile (phải khớp DictionaryAI: src/kim/vector/browserDinov2.js) ---
KIM_VECTOR_MODEL=onnx-community/dinov2-small
KIM_VECTOR_MODEL_VERSION=ef1fb10
KIM_PREPROCESS_VERSION=kim_canon_v2
KIM_EMBEDDING_PROFILE=cls_l2_v1
KIM_VECTOR_DIMENSION=384
KIM_VECTOR_MIN=0.55

# --- Endpoint embedding / vision ---
KIM_EMBEDDING_ENDPOINT=
KIM_EMBEDDING_BEARER_TOKEN=
GEMINI_API_KEY=
KIM_GEMINI_MODEL=gemini-2.5-flash

# --- Media base (proxy ảnh của DictionaryAI) ---
KIM_MEDIA_BASE_URL=https://<dictionaryai-domain>/api/media